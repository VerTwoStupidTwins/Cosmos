+def _root_managed_home(node: os.stat_result, path: Path) -> bool:
+    """Nix-only exception for a private, root-protected sticky profile home.
+
+    This never changes runtime-file ownership or same-UID socket-peer checks.
+    The private service group may create data, but cannot replace root policy.
+    """
+    if os.environ.get("HERMES_MANAGED") != "nixos" or os.getuid() == 0:
+        return False
+    try:
+        import grp
+        import pwd
+        user = pwd.getpwuid(os.getuid())
+        group = grp.getgrgid(user.pw_gid)
+        if (not stat.S_ISDIR(node.st_mode) or node.st_uid != 0
+                or node.st_gid != user.pw_gid or stat.S_IMODE(node.st_mode) != 0o3770
+                or path.absolute() != path.resolve() or _may_have_access_acl(path)):
+            return False
+        if (group.gr_name != user.pw_name or set(group.gr_mem) - {user.pw_name}
+                or {p.pw_uid for p in pwd.getpwall() if p.pw_gid == user.pw_gid} != {user.pw_uid}):
+            return False
+        # Validate top-down: every already-checked prefix is root controlled,
+        # so the service cannot rename the next directory during this walk.
+        for ancestor in reversed(path.parents):
+            info = ancestor.lstat()
+            if (not stat.S_ISDIR(info.st_mode) or info.st_uid != 0
+                    or info.st_mode & 0o022 or _may_have_access_acl(ancestor)):
+                return False
+        if path.parent.lstat().st_gid != user.pw_gid:
+            return False
+        actual = path.lstat()
+        if (actual.st_dev, actual.st_ino) != (node.st_dev, node.st_ino):
+            return False
+        marker = path / ".managed"
+        info = marker.lstat()
+        if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_gid != user.pw_gid
+                or info.st_nlink != 1 or stat.S_IMODE(info.st_mode) != 0o640
+                or _may_have_access_acl(marker)):
+            return False
+        # The validated root-owned marker cannot be swapped in the sticky home.
+        with marker.open("rb") as stream:
+            return stream.read(17) == b"nixos\n"
+    except (ImportError, KeyError, OSError, ValueError):
+        return False
+
